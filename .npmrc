# 共享包 @lieshoucloud/* 走内网 Nexus（npm-group = npm-hosted + npm-proxy）
# CI / 其他机器如未全局配置 registry，取消下面一行注释：
# registry=https://nexus.ts.huntercat.cn/repository/npm-group/

# 共享包随 tarball 发布 TS 源码，需 babel 编译；hoisted 让 node_modules/@lieshoucloud/* 成为真实目录，
# Taro compile.include 的路径才稳定（软链布局下 webpack 会解析到 .pnpm 真实路径）。
node-linker=hoisted
