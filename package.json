{
  "name": "@lieshoucloud/mini-program-app",
  "version": "0.0.1",
  "private": true,
  "description": "猎手云微信小程序（Taro 4 + React 18）· 上游共享包经内网 Nexus（@lieshoucloud 作用域）消费。",
  "scripts": {
    "dev:weapp": "taro build --type weapp --watch",
    "dev:h5": "taro build --type h5 --watch",
    "build": "taro build --type weapp",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tarojs/components": "4.0.13",
    "@tarojs/react": "4.0.13",
    "@tarojs/runtime": "4.0.13",
    "@tarojs/shared": "4.0.13",
    "@tarojs/taro": "4.0.13",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "@lieshoucloud/contract-api": "^0.2.0",
    "@lieshoucloud/contract-types": "^0.2.0",
    "@lieshoucloud/core-web": "^0.1.0",
    "@lieshoucloud/i18n": "^0.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/preset-react": "^8.0.1",
    "@eslint/js": "^9.15.0",
    "@tarojs/cli": "4.0.13",
    "@tarojs/helper": "4.0.13",
    "@tarojs/plugin-framework-react": "4.0.13",
    "@tarojs/plugin-platform-h5": "4.0.13",
    "@tarojs/plugin-platform-weapp": "4.0.13",
    "@tarojs/webpack5-runner": "4.0.13",
    "@types/node": "~22.9.0",
    "@types/react": "^18.3.12",
    "@types/webpack-env": "^1.18.5",
    "babel-preset-taro": "4.0.13",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.15.0",
    "webpack": "5.91.0",
    "vitest": "^3.0.5",
    "jsdom": "30.0.1"
  },
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "pnpm": ">=9.0.0 <10.0.0"
  },
  "packageManager": "pnpm@9.12.0"
}
